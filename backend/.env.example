# Copy this file to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (postgres://USER:PASSWORD@HOST:PORT/NAME)
DATABASE_URL=postgres://vaeyu:vaeyu_dev_password@localhost:5432/vaeyu_lead_tracker

# CORS — origins allowed to call this API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@vaeyu.local
LEAD_FALLBACK_ALERT_EMAIL=manager@vaeyu.local

# Celery / Redis (task results are stored in the database via django_celery_results)
CELERY_BROKER_URL=redis://localhost:6379/0
# Run tasks synchronously in-process (handy for local dev without a worker/Redis)
CELERY_TASK_ALWAYS_EAGER=False

# Public website enquiry capture endpoint — shared secret the website posts back
WEBSITE_ENQUIRY_API_TOKEN=change-me

# Refresh token cookie — set AUTH_COOKIE_SECURE=True in production (HTTPS only)
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
